# syntax=docker/dockerfile:1
# Native Linux build & regression environment for SailDroid (Android 9 / API 28).
# Works with Apple macOS `container` CLI (native linux/arm64 on Apple Silicon)
# as well as Docker / Podman on both arm64 and amd64 hosts.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    build-essential \
    pkg-config \
    python3 \
    python3-paramiko \
    openjdk-21-jdk \
    aidl \
    aapt \
    libsmali-java \
    rpm \
    libcap2-bin \
    bubblewrap \
    dbus-daemon \
    fakeroot \
    pulseaudio \
    pulseaudio-utils \
    weston \
    sshpass \
    openssh-client \
    tzdata \
    libglib2.0-bin \
    libglib2.0-dev \
    libpulse-dev \
    libwayland-bin \
    libwayland-dev \
    wayland-protocols \
    libegl-dev \
    libgles-dev \
    libpng-dev \
    libdbus-1-dev \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    qtbase5-dev \
    qtbase5-dev-tools \
    qtdeclarative5-dev \
    && if [ "$(uname -m)" != "aarch64" ]; then \
         apt-get install -y --no-install-recommends \
           gcc-aarch64-linux-gnu \
           g++-aarch64-linux-gnu \
           binutils-aarch64-linux-gnu \
           qemu-user-static; \
       fi \
    && ln -sfn "/usr/lib/jvm/java-21-openjdk-$(dpkg --print-architecture)" /usr/lib/jvm/saildroid-jdk21 \
    && git config --system safe.directory '*' \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/saildroid-jdk21
ENV PATH=/usr/lib/jvm/saildroid-jdk21/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV SAILDROID_INPUTS=/cache/saidroid-inputs

WORKDIR /workspace
CMD ["/bin/bash"]
